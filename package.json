{
  "name": "exp3-gameplay-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:stage": "node tools/stage-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
