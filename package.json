    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "eventemitter3": "5.0.4",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
